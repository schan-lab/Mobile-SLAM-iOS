    },
    "デモを終了しました": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo stopped"
          }
        }
      }
    },
    "デモモードがオンです。実機の設定を変えるには、設定画面でデモをオフにしてください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo mode is on. To change the settings of a real sensor, turn the demo off in Settings."
          }
        }
      }
    },
    "デモ（疑似 Mid-360）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo (simulated Mid-360)"
          }
        }
      }
    },
    "バージョン %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@"
          }
        }
      }
    },
    "ファイルを開く": {
      "localizations": {
