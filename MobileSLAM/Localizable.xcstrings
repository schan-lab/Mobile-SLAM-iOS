          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        }
      }
    },
    "現在の Mid-360": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current Mid-360"
          }
        }
      }
    },
    "現在の設定を読み込む": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load Current Settings"
          }
        }
      }
    },
    "生データ保存: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raw data saved: %@"
          }
        }
      }
    },
    "生パケット": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raw packets"
          }
        }
      }
    },
    "研究室の PC": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lab PC"
          }
        }
      }
    },
    "秘密鍵はこの端末のキーチェーンにだけ保存され、外に出ません。公開鍵をコピーして、送信先サーバーの ~/.ssh/authorized_keys に1行で追加してください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The private key is stored only in this device's keychain and never leaves it. Copy the public key and add it as one line to ~/.ssh/authorized_keys on the server."
          }
        }
      }
    },
    "自己位置推定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Localization"
          }
        }
      }
    },
    "自己位置推定でマップを表す格子の大きさです。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size of the cells representing the map in localization."
          }
        }
      }
    },
    "自己位置推定に切り替え": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to Localization"
          }
        }
      }
    },
    "表示": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display"
          }
        }
      }
    },
    "表示・PCD の解像度": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display / PCD resolution"
          }
        }
      }
    },
    "見失いました。再探索中…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lost. Searching again…"
          }
        }
      }
    },
    "規定 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default %@"
          }
        }
      }
    },
    "規定値に戻す": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset to Default"
          }
        }
      }
    },
    "記録の形式": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording format"
          }
        }
      }
    },
    "記録を開始できません: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not start recording: %@"
          }
        }
      }
    },
    "設定": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        }
      }
    },
    "設定は Mid-360 本体に保存され、電源を切っても残ります。わからなくなった場合は、Livox Viewer 2 などで工場出荷時の設定（Mid-360: 192.168.1.1XX、送信先: 192.168.1.50）に戻せます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings are stored in the Mid-360 and kept when it is powered off. If you lose track of them, you can restore the factory settings (Mid-360: 192.168.1.1XX, destination: 192.168.1.50) with Livox Viewer 2 or similar tools."
          }
        }
      }
    },
    "詳細パラメータ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced parameters"
          }
        }
      }
    },
    "認証": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication"
          }
        }
      }
    },
    "認証に失敗しました（公開鍵の登録・ユーザー名・パスワードを確認してください）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication failed (check the registered public key, user name and password)"
          }
        }
      }
    },
    "読み込みました。現在の送信先は %@ です。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loaded. The current destination is %@."
          }
        }
      }
    },
    "読み込み中…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading…"
          }
        }
      }
    },
    "読み込み失敗: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load: %@"
          }
        }
      }
    },
    "転送先パス": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote path"
          }
        }
      }
    },
    "転送先パスは / で始めると絶対パス、それ以外はログインしたディレクトリからの相対パスです。ないフォルダは作ります。空欄ならログインしたディレクトリに送ります。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A path starting with / is absolute; otherwise it is relative to the login directory. Missing folders are created. Leave empty to send to the login directory."
          }
        }
      }
    },
    "近くの点を平面に当てはめるときの許容誤差です。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tolerance when fitting a plane to nearby points."
          }
        }
      }
    },
    "近くの点を無視する距離": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignore Points Closer Than"
          }
        }
      }
    },
    "近傍探索の範囲": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neighbor search range"
          }
        }
      }
    },
    "追跡中": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracking"
          }
        }
      }
    },
    "追跡中、これより一致率が低い結果は使いません。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While tracking, results with a lower match ratio are not used."
          }
        }
      }
    },
    "送信しました: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent: %@"
          }
        }
      }
    },
    "送信できませんでした: %@": {
