            "state": "translated",
            "value": "Open File"
          }
        }
      }
    },
    "プライバシー": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy"
          }
        }
      }
    },
    "マップと照合中…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matching against the map…"
          }
        }
      }
    },
    "マップを選択": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Map"
          }
        }
      }
    },
    "マップを選択してください": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a map"
          }
        }
      }
    },
    "マップ作成": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapping"
          }
        }
      }
    },
    "マップ作成・自己位置推定で、LiDAR からこの距離より近い点を使いません。持っている人の体や手が地図に写り込むのを防ぎます。狭い場所では小さくしてください。（規定 %.1f m、ライブ表示には影響しません）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapping and localization ignore points closer than this to the LiDAR, so the person carrying it does not end up in the map. Reduce it in tight spaces. (Default %.1f m; does not affect the live view.)"
          }
        }
      }
    },
    "マップ作成中": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapping"
          }
        }
      }
    },
    "マップ読み込み: %@点": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Map loaded: %@ points"
          }
        }
      }
    },
    "マップ読み込み失敗: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
