{
  "sourceLanguage": "ja",
  "strings": {
    "%@   %.1f MB   約%@点": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@   %.1f MB   ~%@ points"
          }
        }
      }
    },
    "%@  %.0fk点/s": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  %.0fk pts/s"
          }
        }
      }
    },
    "%@点  PCD保存できます": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ points · ready to save PCD"
          }
        }
      }
    },
    "%@点%@   %.1f × %.1f × %.1f m   %@   %dms": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ points%@   %.1f × %.1f × %.1f m   %@   %d ms"
